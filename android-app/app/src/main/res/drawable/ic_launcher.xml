<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#5F4DCE"
                android:startColor="#FF9A62" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#151529" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#5B4D8A" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_note_mark" />
</layer-list>
